<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #1e3a8a 100%); padding: 2rem 1.5rem;">
  
  <div style="max-width: 460px; width: 100%; background: #ffffff; border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1);">
    
    <div style="background: linear-gradient(135deg, var(--slate-900), var(--slate-800)); padding: 2.25rem 2rem; text-align: center; color: #ffffff; border-bottom: 2px solid var(--primary);">
      <div style="width: 52px; height: 52px; background: var(--primary); border-radius: var(--radius-md); display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 0.85rem; box-shadow: 0 2px 10px rgba(37, 99, 235, 0.4);">
        <i class="fa-solid fa-hotel"></i>
      </div>
      <h2 style="color: #ffffff; font-size: 1.5rem; font-weight: 800; margin: 0;">HostelHub Portal</h2>
      <p style="color: var(--slate-300); font-size: 0.88rem; margin-top: 0.35rem;">Campus Residential & Dining Facility System</p>
    </div>

    <div style="padding: 2rem;">
      <%- include('../partials/alerts') %>

      <!-- Quick 1-Click Demo Login Switchers -->
      <div style="background: var(--bg-subtle); border-radius: var(--radius-md); padding: 0.95rem; margin-bottom: 1.5rem; border: 1px solid var(--border-color);">
        <p style="font-size: 0.75rem; font-weight: 700; color: var(--slate-600); text-transform: uppercase; margin-bottom: 0.55rem; text-align: center; letter-spacing: 0.05em;">
          ⚡ 1-Click Institutional Demo Login
        </p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
          <a href="/auth/demo-login/admin" class="btn btn-secondary btn-sm" style="font-size: 0.8rem;">
            <i class="fa-solid fa-shield-halved" style="color: #f59e0b;"></i> Warden / Admin
          </a>
          <a href="/auth/demo-login/student" class="btn btn-secondary btn-sm" style="font-size: 0.8rem;">
            <i class="fa-solid fa-user-graduate" style="color: var(--primary);"></i> Student
          </a>
        </div>
      </div>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Institutional Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="user@campus.edu" required autofocus>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 0.5rem;">
          <i class="fa-solid fa-right-to-bracket"></i> Sign In to Portal
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.88rem; color: var(--text-secondary);">
        New student without an account?
        <a href="/auth/register" style="font-weight: 700; color: var(--primary);">Register Now</a>
      </div>

      <div style="text-align: center; margin-top: 0.75rem;">
        <a href="/" style="font-size: 0.82rem; color: var(--text-muted);">
          <i class="fa-solid fa-arrow-left"></i> Back to Homepage
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

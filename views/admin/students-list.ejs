<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'Enrolled Students Directory' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <!-- Top Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Hostel Students Directory</h2>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.2rem;">
            Roster of all enrolled students with contact records and active room allocations.
          </p>
        </div>
      </div>

      <!-- Students Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-user-graduate" style="color: var(--primary);"></i>
            Enrolled Students (<%= students.length %>)
          </h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <% if (students.length === 0) { %>
            <p style="text-align: center; padding: 3rem; color: var(--text-muted);">No student records found.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Roll / Reg No.</th>
                    <th>Student Name</th>
                    <th>Branch & Year</th>
                    <th>Gender</th>
                    <th>Allocated Room</th>
                    <th>Student Contact</th>
                    <th>Emergency Contact</th>
                  </tr>
                </thead>
                <tbody>
                  <% students.forEach(s => { %>
                    <tr>
                      <td style="font-family: monospace; font-weight: 700; color: var(--text-primary);">
                        <%= s.rollNo || 'N/A' %>
                      </td>
                      <td>
                        <strong style="font-size: 0.95rem; color: var(--text-primary);"><%= s.name %></strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= s.email %></div>
                      </td>
                      <td>
                        <span style="font-size: 0.85rem; font-weight: 600;"><%= s.department %></span>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= s.yearOfStudy %></div>
                      </td>
                      <td>
                        <span class="badge badge-secondary"><%= s.gender %></span>
                      </td>
                      <td>
                        <% if (s.currentRoom) { %>
                          <span class="badge badge-success">
                            Room <%= s.currentRoom.roomNumber %> (<%= s.currentRoom.block ? s.currentRoom.block.name : '' %>)
                          </span>
                        <% } else { %>
                          <span class="badge badge-warning">Unallotted</span>
                        <% } %>
                      </td>
                      <td>
                        <div style="font-size: 0.85rem;"><i class="fa-solid fa-phone" style="color: var(--text-muted); margin-right: 0.3rem;"></i><%= s.phone || 'N/A' %></div>
                      </td>
                      <td>
                        <% if (s.emergencyContact && s.emergencyContact.phone) { %>
                          <div style="font-size: 0.82rem;">
                            <strong><%= s.emergencyContact.name || 'Guardian' %>:</strong> <%= s.emergencyContact.phone %>
                          </div>
                        <% } else { %>
                          <span style="font-size: 0.78rem; color: var(--text-muted);">Not Provided</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>

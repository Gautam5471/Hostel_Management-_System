<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'Hostel Maintenance Helpdesk' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <!-- Top Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Maintenance Complaints & Tickets</h2>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.2rem;">
            Assign maintenance technicians, monitor repair workflows, and close resolved tickets.
          </p>
        </div>
      </div>

      <!-- Filters -->
      <div class="card" style="margin-bottom: 1.75rem;">
        <div class="card-body" style="padding: 1.25rem 1.5rem;">
          <form method="GET" action="/admin/maintenance" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
            <div style="flex: 1; min-width: 150px;">
              <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Status</label>
              <select name="status" class="form-select">
                <option value="all">All Statuses</option>
                <option value="Reported" <%= selectedFilters.status === 'Reported' ? 'selected' : '' %>>Reported (New)</option>
                <option value="In Progress" <%= selectedFilters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                <option value="Resolved" <%= selectedFilters.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                <option value="Closed" <%= selectedFilters.status === 'Closed' ? 'selected' : '' %>>Closed</option>
              </select>
            </div>

            <div style="flex: 1; min-width: 150px;">
              <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Priority</label>
              <select name="priority" class="form-select">
                <option value="all">All Priorities</option>
                <option value="Emergency" <%= selectedFilters.priority === 'Emergency' ? 'selected' : '' %>>Emergency</option>
                <option value="High" <%= selectedFilters.priority === 'High' ? 'selected' : '' %>>High</option>
                <option value="Medium" <%= selectedFilters.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="Low" <%= selectedFilters.priority === 'Low' ? 'selected' : '' %>>Low</option>
              </select>
            </div>

            <div style="flex: 1; min-width: 150px;">
              <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Category</label>
              <select name="category" class="form-select">
                <option value="all">All Categories</option>
                <option value="Electrical" <%= selectedFilters.category === 'Electrical' ? 'selected' : '' %>>Electrical</option>
                <option value="Plumbing" <%= selectedFilters.category === 'Plumbing' ? 'selected' : '' %>>Plumbing</option>
                <option value="Carpentry" <%= selectedFilters.category === 'Carpentry' ? 'selected' : '' %>>Carpentry</option>
                <option value="Cleaning" <%= selectedFilters.category === 'Cleaning' ? 'selected' : '' %>>Cleaning</option>
                <option value="Internet" <%= selectedFilters.category === 'Internet' ? 'selected' : '' %>>Internet</option>
              </select>
            </div>

            <div style="display: flex; gap: 0.5rem;">
              <button type="submit" class="btn btn-primary" style="padding: 0.7rem 1.25rem;">
                <i class="fa-solid fa-filter"></i> Filter
              </button>
              <a href="/admin/maintenance" class="btn btn-secondary" style="padding: 0.7rem 1rem;">
                <i class="fa-solid fa-rotate-left"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Tickets Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-screwdriver-wrench" style="color: var(--primary);"></i>
            Active Complaints Helpdesk (<%= tickets.length %>)
          </h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <% if (tickets.length === 0) { %>
            <p style="text-align: center; padding: 3rem; color: var(--text-muted);">No maintenance tickets matching filter criteria.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Ticket ID</th>
                    <th>Student & Room</th>
                    <th>Issue Summary</th>
                    <th>Category / Priority</th>
                    <th>Date Reported</th>
                    <th>Assigned Staff</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% tickets.forEach(ticket => { %>
                    <tr>
                      <td style="font-family: monospace; font-weight: 700; color: var(--text-secondary);">
                        #<%= ticket._id.toString().slice(-6).toUpperCase() %>
                      </td>
                      <td>
                        <strong style="color: var(--text-primary);"><%= ticket.student ? ticket.student.name : 'Unknown' %></strong>
                        <div style="font-size: 0.75rem; color: var(--primary); font-weight: 700;">
                          Room <%= ticket.room ? ticket.room.roomNumber : 'N/A' %> (<%= ticket.room && ticket.room.block ? ticket.room.block.name : '' %>)
                        </div>
                      </td>
                      <td>
                        <strong style="font-size: 0.9rem; color: var(--text-primary);"><%= ticket.title %></strong>
                        <div style="font-size: 0.78rem; color: var(--text-secondary); max-width: 250px;"><%= ticket.description %></div>
                      </td>
                      <td>
                        <span class="badge badge-secondary" style="margin-bottom: 0.2rem;"><%= ticket.category %></span><br>
                        <span class="badge <%= ticket.priority === 'Emergency' ? 'badge-danger' : (ticket.priority === 'High' ? 'badge-amber' : 'badge-info') %>">
                          <%= ticket.priority %>
                        </span>
                      </td>
                      <td style="font-size: 0.85rem; color: var(--text-secondary);"><%= formatDate(ticket.createdAt) %></td>
                      <td>
                        <div style="font-size: 0.82rem; font-weight: 600;"><%= ticket.assignedTechnician %></div>
                        <% if (ticket.resolutionNotes) { %>
                          <div style="font-size: 0.75rem; color: var(--success-text); margin-top: 0.2rem;">Note: <%= ticket.resolutionNotes %></div>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge <%= getStatusBadgeClass(ticket.status) %>"><%= ticket.status %></span>
                      </td>
                      <td>
                        <button type="button" class="btn btn-secondary btn-sm" data-modal-target="updateTicketModal-<%= ticket._id %>">
                          <i class="fa-solid fa-wrench"></i> Update
                        </button>
                      </td>
                    </tr>

                    <!-- Modal: Update Maintenance Ticket -->
                    <div class="modal-overlay" id="updateTicketModal-<%= ticket._id %>">
                      <div class="modal-card">
                        <div class="modal-header">
                          <h3 style="font-size: 1.2rem; font-weight: 700; margin: 0;">Update Ticket #<%= ticket._id.toString().slice(-6).toUpperCase() %></h3>
                          <button type="button" class="modal-close" data-modal-close>&times;</button>
                        </div>
                        <div class="modal-body">
                          <form action="/admin/maintenance/<%= ticket._id %>/update" method="POST">
                            <div class="form-group">
                              <label class="form-label" for="stat-<%= ticket._id %>">Ticket Status *</label>
                              <select name="status" id="stat-<%= ticket._id %>" class="form-select" required>
                                <option value="Reported" <%= ticket.status === 'Reported' ? 'selected' : '' %>>Reported (New)</option>
                                <option value="In Progress" <%= ticket.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                                <option value="Resolved" <%= ticket.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                                <option value="Closed" <%= ticket.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                              </select>
                            </div>

                            <div class="form-group">
                              <label class="form-label" for="tech-<%= ticket._id %>">Assigned Staff / Technician</label>
                              <input type="text" name="assignedTechnician" id="tech-<%= ticket._id %>" class="form-control" value="<%= ticket.assignedTechnician %>" placeholder="e.g. Electrician Mahesh Kumar">
                            </div>

                            <div class="form-group">
                              <label class="form-label" for="notes-<%= ticket._id %>">Resolution Notes & Actions Taken</label>
                              <textarea name="resolutionNotes" id="notes-<%= ticket._id %>" rows="3" class="form-control" placeholder="e.g. Capacitor replaced and fan speed calibrated. Working normally."><%= ticket.resolutionNotes %></textarea>
                            </div>

                            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
                              <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
                              <button type="submit" class="btn btn-primary">Save Ticket</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'Maintenance & Complaints Helpdesk' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <!-- Top Header & Action -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Room Maintenance Tickets</h2>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.2rem;">
            Report electrical, plumbing, carpentry, or Wi-Fi issues in your room.
          </p>
        </div>

        <% if (activeAllotment) { %>
          <button type="button" class="btn btn-primary" data-modal-target="newComplaintModal">
            <i class="fa-solid fa-plus"></i> Raise Maintenance Ticket
          </button>
        <% } else { %>
          <span style="font-size: 0.85rem; color: var(--text-muted);">
            (Requires active room allotment to lodge tickets)
          </span>
        <% } %>
      </div>

      <!-- Tickets List -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-list-check" style="color: var(--primary);"></i>
            Your Complaint History (<%= requests.length %>)
          </h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <% if (requests.length === 0) { %>
            <div style="text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
              <i class="fa-solid fa-screwdriver-wrench" style="font-size: 3rem; margin-bottom: 1rem; color: #cbd5e1;"></i>
              <h4 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.5rem;">No Maintenance Complaints Found</h4>
              <p style="font-size: 0.88rem; max-width: 380px; margin: 0 auto;">
                Have an issue with electrical fixtures, plumbing, or room furniture? Click "Raise Maintenance Ticket" above.
              </p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Ticket ID</th>
                    <th>Category</th>
                    <th>Issue Description</th>
                    <th>Priority</th>
                    <th>Date Filed</th>
                    <th>Status</th>
                    <th>Technician / Resolution</th>
                  </tr>
                </thead>
                <tbody>
                  <% requests.forEach(ticket => { %>
                    <tr>
                      <td style="font-weight: 700; font-family: monospace; color: var(--text-secondary);">
                        #<%= ticket._id.toString().slice(-6).toUpperCase() %>
                      </td>
                      <td>
                        <span class="badge badge-secondary">
                          <i class="fa-solid fa-tag"></i> <%= ticket.category %>
                        </span>
                      </td>
                      <td>
                        <strong style="color: var(--text-primary); display: block;"><%= ticket.title %></strong>
                        <span style="font-size: 0.82rem; color: var(--text-secondary);"><%= ticket.description %></span>
                      </td>
                      <td>
                        <span class="badge <%= ticket.priority === 'Emergency' ? 'badge-danger' : (ticket.priority === 'High' ? 'badge-amber' : 'badge-info') %>">
                          <%= ticket.priority %>
                        </span>
                      </td>
                      <td style="font-size: 0.85rem; color: var(--text-secondary);"><%= formatDate(ticket.createdAt) %></td>
                      <td>
                        <span class="badge <%= getStatusBadgeClass(ticket.status) %>"><%= ticket.status %></span>
                      </td>
                      <td>
                        <div style="font-size: 0.82rem;">
                          <strong><%= ticket.assignedTechnician %></strong>
                          <% if (ticket.resolutionNotes) { %>
                            <div style="color: var(--success-text); background: var(--success-light); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); margin-top: 0.25rem;">
                              <%= ticket.resolutionNotes %>
                            </div>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Modal: Raise New Ticket -->
<% if (activeAllotment) { %>
<div class="modal-overlay" id="newComplaintModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Raise Maintenance Complaint</h3>
      <button type="button" class="modal-close" data-modal-close>&times;</button>
    </div>
    <div class="modal-body">
      <form action="/student/maintenance" method="POST">
        
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="category">Category *</label>
            <select name="category" id="category" class="form-select" required>
              <option value="Electrical">⚡ Electrical (Fan, Lights, Switch)</option>
              <option value="Plumbing">🚰 Plumbing (Tap, Geyser, Drain)</option>
              <option value="Carpentry">🪑 Carpentry (Door, Bed, Cupboard)</option>
              <option value="Cleaning">🧹 Cleaning / Housekeeping</option>
              <option value="Internet">📶 Internet / Wi-Fi Router</option>
              <option value="Appliance">🔌 Appliance / Air Conditioner</option>
              <option value="Other">🛠️ Other Facility Issue</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="priority">Urgency Priority *</label>
            <select name="priority" id="priority" class="form-select" required>
              <option value="Low">Low (Can wait 2-3 days)</option>
              <option value="Medium" selected>Medium (Standard 24h)</option>
              <option value="High">High (Needs immediate attention)</option>
              <option value="Emergency">Emergency (Safety / Water leakage)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="title">Complaint Summary *</label>
          <input type="text" name="title" id="title" class="form-control" placeholder="e.g. Ceiling fan making loud noise and regulator broken" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Detailed Description *</label>
          <textarea name="description" id="description" rows="3" class="form-control" placeholder="Specify exact location in the room (e.g. Desk #2 socket not working since yesterday)" required></textarea>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane"></i> Submit Ticket
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>

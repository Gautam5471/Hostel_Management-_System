<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'Mess Meal Feedback & Ratings' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem;">
        
        <!-- Submit Feedback Form -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">
              <i class="fa-solid fa-star" style="color: #f59e0b;"></i>
              Rate Today's Food Quality
            </h3>
          </div>
          <div class="card-body">
            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
              Your feedback directly impacts the weekly mess menu and kitchen quality control.
            </p>

            <form action="/student/mess-feedback" method="POST">
              <div class="form-grid-2">
                <div class="form-group">
                  <label class="form-label" for="mealDate">Date</label>
                  <input type="date" name="mealDate" id="mealDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="mealType">Meal Slot *</label>
                  <select name="mealType" id="mealType" class="form-select" required>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch" selected>Lunch</option>
                    <option value="Snacks">Evening Snacks</option>
                    <option value="Dinner">Dinner</option>
                  </select>
                </div>
              </div>

              <!-- Interactive Star Rating -->
              <div class="form-group">
                <label class="form-label">Overall Rating (1 to 5 Stars) *</label>
                <div style="display: flex; gap: 0.75rem; font-size: 1.8rem; margin: 0.35rem 0;">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <label style="cursor: pointer;">
                      <input type="radio" name="rating" value="<%= i %>" class="star-rating-radio" style="display: none;" <%= i === 5 ? 'checked' : '' %>>
                      <span class="star-rating-label" style="color: #f59e0b; transition: color 0.15s ease;">
                        <i class="fa-solid fa-star"></i>
                      </span>
                    </label>
                  <% } %>
                </div>
                <span style="font-size: 0.78rem; color: var(--text-muted);">1 = Poor &bull; 5 = Excellent Food & Hygiene</span>
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Primary Aspect</label>
                <select name="category" id="category" class="form-select">
                  <option value="Taste & Quality">Taste & Food Quality</option>
                  <option value="Hygiene & Cleanliness">Hygiene & Dining Hall Cleanliness</option>
                  <option value="Quantity & Portions">Quantity & Serving Portions</option>
                  <option value="Staff Courtesy">Mess Staff Courtesy</option>
                  <option value="Overall Experience">Overall Dining Experience</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="comments">Comments & Suggestions</label>
                <textarea name="comments" id="comments" rows="3" class="form-control" placeholder="Tell us what you liked or how we can improve..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-block">
                <i class="fa-solid fa-paper-plane"></i> Submit Feedback
              </button>
            </form>
          </div>
        </div>

        <!-- Student's Recent Feedback History -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">
              <i class="fa-solid fa-clock-rotate-left"></i>
              Your Feedback History (<%= feedbacks.length %>)
            </h3>
          </div>
          <div class="card-body" style="padding: 0;">
            <% if (feedbacks.length === 0) { %>
              <p style="text-align: center; padding: 3rem 1rem; color: var(--text-muted); font-size: 0.9rem;">
                You haven't submitted any meal ratings yet.
              </p>
            <% } else { %>
              <div style="display: flex; flex-direction: column;">
                <% feedbacks.forEach(fb => { %>
                  <div style="padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 0.4rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <div>
                        <strong style="font-size: 0.95rem; color: var(--text-primary);"><%= fb.mealType %></strong>
                        <span style="font-size: 0.78rem; color: var(--text-muted); margin-left: 0.35rem;">(<%= formatDate(fb.mealDate) %>)</span>
                      </div>
                      <div style="color: #f59e0b; font-size: 0.9rem;">
                        <% for (let s = 1; s <= 5; s++) { %>
                          <i class="fa-<%= s <= fb.rating ? 'solid' : 'regular' %> fa-star"></i>
                        <% } %>
                      </div>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--text-secondary);">
                      <span class="badge badge-secondary" style="font-size: 0.72rem; padding: 0.15rem 0.5rem;"><%= fb.category %></span>
                      <% if (fb.comments) { %>
                        <p style="margin: 0.35rem 0 0 0; color: var(--text-primary); font-style: italic;">"<%= fb.comments %>"</p>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>

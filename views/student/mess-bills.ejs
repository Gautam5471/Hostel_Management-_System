<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'Monthly Mess Billing & Invoices' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <!-- Top Overview Banner -->
      <div style="background: linear-gradient(135deg, #1e293b, #334155); border-radius: var(--radius-xl); padding: 1.75rem 2.25rem; color: #ffffff; margin-bottom: 2rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="badge badge-info" style="margin-bottom: 0.5rem;">Automated Attendance-Based Billing</span>
          <h2 style="color: #ffffff; font-size: 1.5rem; font-weight: 800; margin: 0;">Monthly Dining Statements</h2>
          <p style="color: #cbd5e1; font-size: 0.9rem; margin-top: 0.25rem;">
            Mess charges are calculated dynamically based on days present with full rebate credit for logged absences.
          </p>
        </div>
      </div>

      <!-- Billing Cards / Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-file-invoice-dollar" style="color: var(--primary);"></i>
            Your Billing History (<%= bills.length %>)
          </h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <% if (bills.length === 0) { %>
            <div style="text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
              <i class="fa-solid fa-receipt" style="font-size: 3rem; margin-bottom: 1rem; color: #cbd5e1;"></i>
              <h4 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.5rem;">No Invoices Generated Yet</h4>
              <p style="font-size: 0.88rem; max-width: 380px; margin: 0 auto;">
                Monthly mess statements are generated by the administration at the end of each billing cycle.
              </p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Billing Period</th>
                    <th>Days (Pres / Abs)</th>
                    <th>Base Rate</th>
                    <th>Rebate Credit</th>
                    <th>Net Dues</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% bills.forEach(bill => { %>
                    <tr>
                      <td>
                        <strong style="color: var(--text-primary); font-size: 0.95rem;">
                          <%= bill.month %> <%= bill.year %>
                        </strong>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">
                          Total <%= bill.totalDaysInMonth %> Days
                        </span>
                      </td>
                      <td>
                        <span style="color: var(--success-text); font-weight: 700;"><%= bill.presentDays %> Present</span> / 
                        <span style="color: var(--danger-text);"><%= bill.absentDays %> Absent</span>
                      </td>
                      <td><%= formatINR(bill.baseAmount) %></td>
                      <td style="color: var(--success-text); font-weight: 700;">
                        -<%= formatINR(bill.rebateAmount) %>
                      </td>
                      <td>
                        <strong style="font-size: 1.05rem; color: var(--primary);">
                          <%= formatINR(bill.netAmount) %>
                        </strong>
                      </td>
                      <td style="font-size: 0.85rem; color: var(--text-secondary);"><%= formatDate(bill.dueDate) %></td>
                      <td>
                        <span class="badge <%= getStatusBadgeClass(bill.status) %>"><%= bill.status %></span>
                      </td>
                      <td>
                        <div style="display: flex; gap: 0.5rem;">
                          <button type="button" class="btn btn-secondary btn-sm" data-modal-target="invoiceModal-<%= bill._id %>">
                            <i class="fa-solid fa-receipt"></i> View Invoice
                          </button>
                          
                          <% if (bill.status !== 'Paid') { %>
                            <form action="/student/bills/<%= bill._id %>/pay" method="POST" style="margin: 0;">
                              <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa-solid fa-credit-card"></i> Pay Now
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>

                    <!-- Modal: Printable Invoice Receipt -->
                    <div class="modal-overlay" id="invoiceModal-<%= bill._id %>">
                      <div class="modal-card" style="max-width: 650px;">
                        <div class="modal-header">
                          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">
                            Mess Fee Invoice — <%= bill.month %> <%= bill.year %>
                          </h3>
                          <button type="button" class="modal-close" data-modal-close>&times;</button>
                        </div>
                        <div class="modal-body" style="padding: 2rem;">
                          
                          <div style="display: flex; justify-content: space-between; border-bottom: 2px solid var(--border-color); padding-bottom: 1.25rem; margin-bottom: 1.25rem;">
                            <div>
                              <h2 style="font-size: 1.3rem; font-weight: 800; color: var(--primary); margin: 0;">HostelHub Dining Services</h2>
                              <span style="font-size: 0.82rem; color: var(--text-muted);">Campus Hostel & Mess Administration</span>
                            </div>
                            <div style="text-align: right;">
                              <span class="badge <%= getStatusBadgeClass(bill.status) %>" style="font-size: 0.85rem; padding: 0.35rem 0.85rem;">
                                <%= bill.status %>
                              </span>
                              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
                                Ref: #BILL-<%= bill._id.toString().slice(-8).toUpperCase() %>
                              </div>
                            </div>
                          </div>

                          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.88rem;">
                            <div>
                              <strong style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Billed To:</strong>
                              <div style="font-weight: 700; color: var(--text-primary); font-size: 1rem;"><%= currentUser.name %></div>
                              <div>Roll No: <%= currentUser.rollNo || 'N/A' %></div>
                              <div>Dept: <%= currentUser.department || 'N/A' %></div>
                            </div>
                            <div style="text-align: right;">
                              <strong style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Billing Period:</strong>
                              <div style="font-weight: 700; color: var(--text-primary);"><%= bill.month %> <%= bill.year %></div>
                              <div>Due Date: <%= formatDate(bill.dueDate) %></div>
                              <% if (bill.paidAt) { %>
                                <div style="color: var(--success-text); font-weight: 600;">Paid On: <%= formatDate(bill.paidAt) %></div>
                              <% } %>
                            </div>
                          </div>

                          <table style="width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: 0.9rem;">
                            <thead>
                              <tr style="background: var(--bg-subtle); border-bottom: 1.5px solid var(--border-color);">
                                <th style="padding: 0.6rem 0.85rem; text-align: left;">Description</th>
                                <th style="padding: 0.6rem 0.85rem; text-align: right;">Rate / Unit</th>
                                <th style="padding: 0.6rem 0.85rem; text-align: right;">Amount</th>
                              </tr>
                            </thead>
                            <tbody>
                              <tr style="border-bottom: 1px solid var(--border-color);">
                                <td style="padding: 0.75rem 0.85rem;">
                                  <strong>Monthly Dining Base Charge</strong>
                                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= bill.totalDaysInMonth %> Days @ ₹<%= bill.dailyRate %>/day</div>
                                </td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right;">₹<%= bill.dailyRate %>/day</td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right;"><%= formatINR(bill.baseAmount) %></td>
                              </tr>
                              <tr style="border-bottom: 1px solid var(--border-color); color: var(--success-text);">
                                <td style="padding: 0.75rem 0.85rem;">
                                  <strong>Mess Leave Absence Rebate</strong>
                                  <div style="font-size: 0.75rem;"><%= bill.absentDays %> approved absent days deducted</div>
                                </td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right;">-₹<%= bill.dailyRate %>/day</td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right; font-weight: 700;">-<%= formatINR(bill.rebateAmount) %></td>
                              </tr>
                              <tr style="border-bottom: 1.5px solid var(--border-color);">
                                <td style="padding: 0.75rem 0.85rem;">
                                  <strong>Dining Hall Utility & Maintenance</strong>
                                  <div style="font-size: 0.75rem; color: var(--text-muted);">Water, kitchen hygiene & sanitization</div>
                                </td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right;">Fixed</td>
                                <td style="padding: 0.75rem 0.85rem; text-align: right;"><%= formatINR(bill.utilityCharge) %></td>
                              </tr>
                              <tr style="background: var(--bg-subtle); font-weight: 800; font-size: 1.05rem;">
                                <td colspan="2" style="padding: 0.85rem; text-align: right;">Net Payable:</td>
                                <td style="padding: 0.85rem; text-align: right; color: var(--primary);"><%= formatINR(bill.netAmount) %></td>
                              </tr>
                            </tbody>
                          </table>

                          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
                            <span style="font-size: 0.78rem; color: var(--text-muted);">This is a computer-generated institutional receipt.</span>
                            <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                              <i class="fa-solid fa-print"></i> Print Invoice
                            </button>
                          </div>

                        </div>
                      </div>
                    </div>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/navbar', { pageHeading: 'My Room & Living Details' }) %>

    <div class="content-wrapper">
      <%- include('../partials/alerts') %>

      <% if (!activeAllotment) { %>
        <!-- No Room State -->
        <div style="background: #ffffff; border-radius: var(--radius-xl); padding: 4rem 2rem; text-align: center; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm); max-width: 600px; margin: 2rem auto;">
          <div style="width: 80px; height: 80px; background: var(--primary-light); color: var(--primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 2.5rem; margin-bottom: 1.5rem;">
            <i class="fa-solid fa-hotel"></i>
          </div>
          <h2 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 0.75rem;">No Room Currently Allotted</h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 2rem;">
            You do not have an active hostel bed allotment. Explore available hostel blocks and submit an application.
          </p>
          <a href="/student/rooms" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-magnifying-glass-location"></i> Browse Available Rooms
          </a>
        </div>

      <% } else { %>

        <!-- Active Room Header Card -->
        <div class="card" style="margin-bottom: 2rem; border-top: 4px solid var(--primary);">
          <div class="card-body" style="padding: 2.25rem;">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 1.5rem;">
              <div>
                <span class="badge badge-success" style="margin-bottom: 0.5rem;">Active Allotment</span>
                <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin: 0;">
                  Room <%= activeAllotment.room.roomNumber %> &bull; Bed #<%= activeAllotment.bedNumber %>
                </h2>
                <p style="color: var(--text-secondary); font-size: 1rem; margin-top: 0.25rem;">
                  <%= activeAllotment.room.block.name %> (<%= activeAllotment.room.block.genderType %> Block) &bull; Floor <%= activeAllotment.room.floor %>
                </p>
              </div>

              <!-- Quick Actions -->
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <button type="button" class="btn btn-secondary" data-modal-target="roomChangeModal">
                  <i class="fa-solid fa-arrows-rotate"></i> Request Room Change
                </button>
                <button type="button" class="btn btn-danger" data-modal-target="vacateModal">
                  <i class="fa-solid fa-right-from-bracket"></i> Request Vacate / Checkout
                </button>
              </div>
            </div>

            <!-- Detailed Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; background: var(--bg-subtle); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
              <div>
                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Room Type</span>
                <p style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-top: 0.2rem;">
                  <%= activeAllotment.room.roomType %> (<%= activeAllotment.room.isAc ? 'Air Conditioned' : 'Non-AC' %>)
                </p>
              </div>

              <div>
                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Monthly Fee</span>
                <p style="font-size: 1.05rem; font-weight: 700; color: var(--primary); margin-top: 0.2rem;">
                  <%= formatINR(activeAllotment.room.pricePerMonth) %> / Month
                </p>
              </div>

              <div>
                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Allotment Date</span>
                <p style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-top: 0.2rem;">
                  <%= formatDate(activeAllotment.allottedDate) %>
                </p>
              </div>

              <div>
                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Warden Desk</span>
                <p style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-top: 0.2rem;">
                  <%= activeAllotment.room.block.wardenInCharge %> (<%= activeAllotment.room.block.contactNumber %>)
                </p>
              </div>
            </div>

            <!-- Room Amenities -->
            <div style="margin-top: 1.5rem;">
              <h4 style="font-size: 0.92rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 0.6rem;">Room Facilities & Amenities</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                <span class="feature-pill"><i class="fa-solid fa-wifi" style="color: var(--primary);"></i> High-speed Campus Wi-Fi</span>
                <span class="feature-pill"><i class="fa-solid fa-bath" style="color: var(--accent);"></i> <%= activeAllotment.room.hasAttachedBathroom ? 'Attached Private Bathroom' : 'Common Restroom' %></span>
                <% if (activeAllotment.room.amenities) { %>
                  <% activeAllotment.room.amenities.forEach(item => { %>
                    <span class="feature-pill"><i class="fa-solid fa-check" style="color: var(--success);"></i> <%= item %></span>
                  <% }) %>
                <% } %>
              </div>
            </div>

          </div>
        </div>

        <!-- Roommates Section -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">
              <i class="fa-solid fa-users" style="color: var(--primary);"></i>
              Roommates in <%= activeAllotment.room.roomNumber %>
            </h3>
            <span style="font-size: 0.85rem; color: var(--text-secondary);">
              Capacity: <%= activeAllotment.room.occupiedBeds %> / <%= activeAllotment.room.capacity %> Occupied
            </span>
          </div>
          <div class="card-body">
            <% if (roommates.length === 0) { %>
              <p style="color: var(--text-muted); text-align: center; padding: 2rem 0; font-size: 0.95rem;">
                You are currently the only occupant in this room. Other beds are available for allotment.
              </p>
            <% } else { %>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
                <% roommates.forEach(mate => { %>
                  <div style="border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.25rem; background: #ffffff; display: flex; flex-direction: column; gap: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.85rem;">
                      <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem;">
                        <%= mate.name.charAt(0) %>
                      </div>
                      <div>
                        <h4 style="font-size: 1rem; font-weight: 700; margin: 0;"><%= mate.name %></h4>
                        <span style="font-size: 0.78rem; color: var(--text-muted);">Bed #<%= mate.bedNumber %> &bull; <%= mate.rollNo %></span>
                      </div>
                    </div>

                    <div style="font-size: 0.82rem; color: var(--text-secondary); border-top: 1px solid var(--border-color); padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem;">
                      <div><i class="fa-solid fa-graduation-cap" style="width: 18px; color: var(--text-muted);"></i> <%= mate.department %></div>
                      <div><i class="fa-solid fa-phone" style="width: 18px; color: var(--text-muted);"></i> <%= mate.phone || 'N/A' %></div>
                      <div><i class="fa-solid fa-envelope" style="width: 18px; color: var(--text-muted);"></i> <%= mate.email %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Pending Change/Vacate Requests Tracker -->
        <% if (pendingRequests.length > 0) { %>
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fa-solid fa-clock-rotate-left" style="color: #f59e0b;"></i>
                Pending Room Requests Under Review
              </h3>
            </div>
            <div class="card-body" style="padding: 0;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Reason</th>
                    <th>Date Submitted</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% pendingRequests.forEach(req => { %>
                    <tr>
                      <td><span class="badge badge-warning"><%= req.requestType %></span></td>
                      <td><%= req.reason %></td>
                      <td><%= formatDate(req.createdAt) %></td>
                      <td><span class="badge <%= getStatusBadgeClass(req.status) %>"><%= req.status %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>

      <% } %>

    </div>
  </div>
</div>

<!-- Modal: Room Change Request -->
<% if (activeAllotment) { %>
<div class="modal-overlay" id="roomChangeModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Request Room Change</h3>
      <button type="button" class="modal-close" data-modal-close>&times;</button>
    </div>
    <div class="modal-body">
      <form action="/student/room-change" method="POST">
        <div class="form-group">
          <label class="form-label" for="changePreferredBlock">Preferred Hostel Block</label>
          <select name="preferredBlock" id="changePreferredBlock" class="form-select">
            <option value="">Any Block</option>
            <% blocks.forEach(b => { %>
              <option value="<%= b._id %>"><%= b.name %> (<%= b.genderType %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="changePreferredType">Preferred Room Type</label>
          <select name="preferredRoomType" id="changePreferredType" class="form-select">
            <option value="Any">Any Room Type</option>
            <option value="Single">Single Bed</option>
            <option value="Double">Double Sharing</option>
            <option value="Triple">Triple Sharing</option>
            <option value="Four-Bed">Four-Bed Sharing</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="changeTargetRoom">Specific Available Room (Optional)</label>
          <select name="targetRoom" id="changeTargetRoom" class="form-select">
            <option value="">Auto-assign best available</option>
            <% availableRooms.forEach(ar => { %>
              <option value="<%= ar._id %>">Room <%= ar.roomNumber %> - <%= ar.block.name %> (<%= ar.roomType %>, <%= ar.occupiedBeds %>/<%= ar.capacity %> filled)</option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="changeReason">Reason for Transfer Request *</label>
          <textarea name="reason" id="changeReason" rows="3" class="form-control" placeholder="Specify valid reason (e.g., medical reasons, branch alignment, study environment)" required></textarea>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane"></i> Submit Transfer Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Vacate Room Request -->
<div class="modal-overlay" id="vacateModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0; color: var(--danger);">Hostel Room Vacation Request</h3>
      <button type="button" class="modal-close" data-modal-close>&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
        Submitting this form requests checkout from <strong>Room <%= activeAllotment.room.roomNumber %> (Bed #<%= activeAllotment.bedNumber %>)</strong>. Once approved by the warden, your bed will be freed for other students and your room dues will be finalized.
      </p>

      <form action="/student/vacate" method="POST">
        <div class="form-group">
          <label class="form-label" for="vacateReason">Reason for Vacating *</label>
          <textarea name="reason" id="vacateReason" rows="3" class="form-control" placeholder="Reason (e.g., Graduation, Semester exchange, Moving to day-scholar, Internship)" required></textarea>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-door-closed"></i> Confirm Vacate Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
